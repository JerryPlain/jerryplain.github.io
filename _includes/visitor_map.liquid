{% if site.revolvermaps_id %}
  <!-- Visitor globe: the RevolverMaps2 script counts the visit as soon as it runs -->
  <!-- and drops the globe in as a lazy iframe right after its own tag, so the -->
  <!-- wrapper reserves the square up front to keep the page from jumping. The -->
  <!-- widget page declares no colour scheme, so the wrapper pins "light" to -->
  <!-- match it: a mismatch makes the browser paint an opaque white backdrop -->
  <!-- behind the transparent iframe in dark mode. -->
  <style>
    .visitor-map {
      margin: 3.5rem auto 0;
      text-align: center;
    }
    .visitor-map__note {
      font-size: 0.78rem;
      line-height: 1.5;
      color: var(--global-text-color-light);
      max-width: 34rem;
      margin: 0 auto 0.7rem;
    }
    .visitor-map__globe {
      width: 300px;
      max-width: 100%;
      aspect-ratio: 1 / 1;
      margin: 0 auto;
      color-scheme: light;
    }
  </style>
  <section class="visitor-map">
    <p class="visitor-map__note">This globe shows approximate locations of visitors. No personally identifiable information is stored.</p>
    <div class="visitor-map__globe">
      <script
        src="https://revolvermaps2.com/embed.js"
        data-site="{{ site.revolvermaps_id }}"
        data-size="300"
        data-theme="{{ site.revolvermaps_theme | default: 'night' }}"
        data-color="{{ site.revolvermaps_color | default: 'ffb23f' }}"
        async
      ></script>
    </div>
  </section>
{% endif %}
