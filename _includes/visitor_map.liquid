{% if site.mapmyvisitors_id %}
  <!-- Visitor map: the MapMyVisitors image is itself the tracker — fetching it -->
  <!-- registers the visit, so no extra script is needed, and it is deliberately -->
  <!-- NOT lazy-loaded: a visitor who never scrolls this far would otherwise go -->
  <!-- uncounted. Requested at twice the displayed width to stay sharp on retina; -->
  <!-- clicking opens the full stats page. -->
  <style>
    .visitor-map {
      margin: 3.5rem auto 0;
      text-align: center;
    }
    .visitor-map__note {
      font-size: 0.78rem;
      line-height: 1.5;
      color: var(--global-text-color-light);
      max-width: 34rem;
      margin: 0 auto 0.7rem;
    }
    .visitor-map__link {
      display: inline-block;
      max-width: 100%;
      line-height: 0;
      border-radius: 0.5rem;
      overflow: hidden;
      border: 1px solid var(--global-divider-color);
    }
    .visitor-map__link img {
      width: 600px;
      max-width: 100%;
      height: auto;
    }
  </style>
  <section class="visitor-map">
    <p class="visitor-map__note">This map shows approximate locations of visitors. No personally identifiable information is stored.</p>
    <a
      class="visitor-map__link"
      href="https://mapmyvisitors.com/web/{{ site.mapmyvisitors_profile }}"
      target="_blank"
      rel="noopener nofollow"
      title="See where visitors come from"
    >
      <img
        src="https://mapmyvisitors.com/map.png?d={{ site.mapmyvisitors_id }}&amp;cl=000033&amp;w=1200"
        alt="Map of approximate visitor locations"
        width="1200"
        height="613"
        decoding="async"
      >
    </a>
  </section>
{% endif %}
