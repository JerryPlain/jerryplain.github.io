{% comment %}
  News as compact dated rows, replacing al_folio_core's table.

  `limit=true` (the home page) shows the newest `page.announcements.limit`
  items (all of them when the limit is blank) in a thin outlined box that
  scrolls once the list outgrows it. The /news/ page includes this without
  `limit` and shows every item, unboxed and grouped by year.
{% endcomment %}

{% assign news_items = site.news | sort: 'date' | reverse %}
{% if include.limit and page.announcements.limit %}
  {% assign news_items = news_items | slice: 0, page.announcements.limit %}
{% endif %}

{% if include.limit %}
  <div class="news{% if page.announcements.scrollable %} news--scroll{% endif %}">
    {% if news_items != blank %}
      <div class="news__scroller">
        <ul class="news-list">
          {% for item in news_items %}
            {% include news_entry.liquid item=item format='%b %Y' %}
          {% endfor %}
        </ul>
      </div>
    {% else %}
      <p>No news so far...</p>
    {% endif %}
  </div>
{% else %}
  {% comment %} /news/: one section per year, each under its own heading {% endcomment %}
  <div class="news news--page">
    {% assign news_years = news_items | group_by_exp: 'item', "item.date | date: '%Y'" %}
    {% for year in news_years %}
      <section class="news-year">
        <h2 class="exp-section">{{ year.name }}</h2>
        <ul class="news-list">
          {% for item in year.items %}
            {% include news_entry.liquid item=item format='%b %d' %}
          {% endfor %}
        </ul>
      </section>
    {% else %}
      <p>No news so far...</p>
    {% endfor %}
  </div>
{% endif %}
