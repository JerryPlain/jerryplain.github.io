{% comment %}
  News as compact dated rows, replacing al_folio_core's table.

  `limit=true` (the home page) shows the newest `page.announcements.limit`
  items (all of them when the limit is blank) in a thin outlined box that
  scrolls once the list outgrows it. The /news/ page includes this without
  `limit` and shows every item, unboxed.
{% endcomment %}

{% assign news_items = site.news | sort: 'date' | reverse %}
{% if include.limit and page.announcements.limit %}
  {% assign news_items = news_items | slice: 0, page.announcements.limit %}
{% endif %}

<div class="news{% if include.limit and page.announcements.scrollable %} news--scroll{% endif %}">
  {% if news_items != blank %}
    <div class="news__scroller">
      <ul class="news-list">
        {% for item in news_items %}
          <li class="news-entry">
            <time class="news-entry__date" datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%b %Y' }}</time>
            <div class="news-entry__text">
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
