---
layout: default
---
{% comment %}
  Home page, "paper & glass" (after wenlixiao.com): the portrait beside the
  intro, then News, Research and Background as frosted cards on warm paper.
  Styles: assets/css/custom.css. Behaviour (scroll reveal, news box,
  timeline): assets/js/home-effects.js.
{% endcomment %}

<div class="pg-home" id="about-content">
  <section class="pg-intro" data-reveal>
    <div class="pg-intro__portrait">
      <img
        src="{{ page.profile_photo | default: '/assets/img/head2.jpg' | relative_url | bust_file_cache }}"
        alt="{{ site.first_name }} {{ site.last_name }}"
        width="256"
        height="256"
        fetchpriority="high"
      >
    </div>
    <div class="pg-intro__body">
      <h1 class="pg-intro__name">
        {{ site.first_name }}
        {{ site.last_name }}
      </h1>
      {% if page.subtitle %}
        <p class="pg-intro__motto">
          <span class="pg-intro__quote">{{ page.subtitle | strip_html }}</span>
          {% if page.subtitle_source %}
            <span class="pg-intro__credit">
              — <cite>{{ page.subtitle_source | strip_html }}</cite>
              {%- if page.subtitle_source_by %}, {{ page.subtitle_source_by | strip_html }}{% endif %}
            </span>
          {% endif %}
        </p>
      {% endif %}
      <div class="pg-intro__bio">{{ content }}</div>
      {% include quicklinks.liquid %}
    </div>
  </section>

  <div data-reveal>{% include chat_invite.liquid %}</div>

  {% if page.announcements and page.announcements.enabled %}
    <section class="pg-section" id="news">
      <h2 class="pg-section__title" data-reveal>
        <a href="{{ '/news/' | relative_url }}">News</a>
      </h2>
      <div class="pg-card pg-news" data-reveal>
        {% include news.liquid limit=true %}
      </div>
    </section>
  {% endif %}

  {% if page.selected_papers %}
    <section class="pg-section" id="research">
      <h2 class="pg-section__title" data-reveal>
        <a href="{{ '/publications/' | relative_url }}">Research</a>
      </h2>
      <div class="research">
        {% bibliography --template research_card --group_by none --query @*[selected=true]* %}
      </div>
      <p class="pg-more" data-reveal>
        <a href="{{ '/publications/' | relative_url }}">All publications <span aria-hidden="true">&rarr;</span></a>
      </p>
    </section>
  {% endif %}

  {% if site.data.experience %}
    <section class="pg-section" id="background">
      <h2 class="pg-section__title" data-reveal>
        <a href="{{ '/experience/' | relative_url }}">Background</a>
      </h2>
      <div data-reveal>{% include background_timeline.liquid %}</div>
    </section>
  {% endif %}

  {% comment %} Visitor globe, last thing on the page above the footer {% endcomment %}
  {% include visitor_map.liquid %}
</div>

{% comment %}
  al-folio leaves the navbar brand out on the home page; put the name (with
  the SZ monogram, drawn by custom.css) back so every page shares one bar.
{% endcomment %}
<script>
  (function () {
    var nav = document.getElementById('navbar');
    var container = nav && nav.querySelector('.container');
    if (container && !container.querySelector('.navbar-brand')) {
      var a = document.createElement('a');
      a.className = 'navbar-brand title';
      a.href = "{{ '/' | relative_url }}";
      a.textContent = '{{ site.first_name }} {{ site.last_name }}';
      container.insertBefore(a, container.firstChild);
    }
  })();
</script>

<script src="{{ '/assets/js/home-effects.js' | relative_url | bust_file_cache }}" defer></script>
