@inproceedings{zhang-etal-2026-surgagentgym,
  bibtex_show = {true},
  title       = {How to ``Train'' a Surgeon? Benchmarking Generalist Agents in Surgical Scene Understanding},
  author      = {Zhang, Gengyuan and Han*, Xiao and Zhou*, Shijie and Koukash*, Abdullah and Wu, Jingpei and Gu, Jindong and Zhu, Yuqicheng and Navab, Nassir and Tresp, Volker and Ghazaei, Ghazal},
  author_note = {* Co-second authors, equal contribution},
  booktitle   = {Advances in Neural Information Processing Systems (NeurIPS), Evaluations and Datasets Track},
  year        = {2026},
  url         = {https://neurips.cc/virtual/2026/loc/sydney/poster/139078},
  website     = {https://vitagent.github.io/},
  abstract    = {Evaluating general-purpose multimodal large language models (MLLMs) for surgical scene understanding remains limited due to scarce surgical data and fragmented evaluation protocols. We address these challenges through a two-stage evaluation framework for surgical scene understanding. In Stage I, we introduce SurgKnowBench, a diagnostic benchmark that harmonizes public surgical datasets across procedures and tasks and evaluates proprietary and open-source MLLMs to map the boundary of pretrained surgical competence. SurgKnowBench reveals that current models retain partial visual priors but remain weak on relational and procedural understanding and workflow assessment. Building on this failure frontier and motivated by the scaffolded nature of surgical training, we introduce SurgAgentGym, an agentic environment where general-purpose MLLM agents can use bounded knowledge search over SurgWiki and general-purpose visual grounding for surgical tasks. SurgAgentGym evaluates whether generalist agents can improve surgical understanding at inference time through tool-mediated evidence use, without additional surgical training. Our results show that agentic inference narrows the gap mainly for perception-heavy tasks, while fine-grained localization and expert-style assessment remain persistent bottlenecks. This opens a path toward future studies of agentic surgical understanding.},
  venue       = {Conference on Neural Information Processing Systems (NeurIPS)},
  preview     = {surgagentgym_plate.jpg},
  preview_full = {surgagentgym_fig1.jpg},
  role        = {Co-Second Author},
  tldr        = {A two-stage study of generalist multimodal LLMs in surgery: SurgKnowBench maps what pretrained models already know, and SurgAgentGym tests whether tool-using agents close the gap at inference time, without any surgical training.},
  selected    = {true}
}

@inproceedings{nakka-etal-2026-privacyevalclaw,
  bibtex_show = {true},
  title       = {{P}rivacy{E}val{C}law: A Tool-Augmented Deliberative Agent for Auditing Privacy Leakage in {LLM} Jailbreak Responses},
  author      = {Nakka, Krishna Kanth and Wang, Yujun and Zhou, Shijie and Nguyen, Tu and Gelardi, Gabriele and Zhou, Xuebing},
  booktitle   = {Findings of the Association for Computational Linguistics: AACL-IJCNLP 2026},
  year        = {2026},
  publisher   = {Association for Computational Linguistics},
  url         = {https://krishnakanthnakka.github.io/privacyevalclaw},
  abstract    = {Privacy auditing of large language models (LLMs) increasingly relies on advanced jailbreak attacks to uncover unintended disclosures of personal information; the reliability of such audits, however, hinges on evaluators that can accurately determine whether a response constitutes privacy leakage. This evaluation remains challenging because disclosures may be indirect, contextual, partial, or obfuscated, and different evaluators can interpret the same response differently. We conduct a systematic study of guard models and LLM-as-Judges and find substantial disagreement among evaluators, particularly in ambiguous cases that require additional evidence or targeted analysis to resolve. Motivated by these findings, we introduce PrivacyEvalClaw, a training-free deliberative agent for evaluating privacy leakage in LLM jailbreak responses. Rather than relying on isolated single-pass judgments, PrivacyEvalClaw treats evaluators and analysis modules as tools, adaptively gathers evidence, investigates uncertain disclosures, and reconciles conflicting signals before producing a final judgment. Our primary experiments use pairwise LLM-as-Judge evaluation of complete trajectories, showing that PrivacyEvalClaw achieves favorable win rates against competing baselines across outcome, process, and overall quality, while also producing explicit reasoning traces that make the evaluation process more transparent and auditable.},
  pdf         = {https://arxiv.org/pdf/2610.36711},
  arxiv       = {2610.36711},
  website     = {https://krishnakanthnakka.github.io/privacyevalclaw},
  venue       = {Conference of the Asia-Pacific Chapter of the ACL (AACL-IJCNLP)},
  preview     = {privacyevalclaw.png},
  preview_full = {privacyevalclaw_full.png},
  role        = {Co-Author},
  tldr        = {A training-free deliberative agent that audits privacy leakage in jailbreak responses, using guard models and LLM judges as tools and reconciling their disagreements before it rules.},
}

@inproceedings{zhang-etal-2025-swarmagentic,
  bibtex_show = {true},
  title       = {{S}warm{A}gentic: Towards Fully Automated Agentic System Generation via Swarm Intelligence},
  author      = {Zhang, Yao and Lin, Chenyang and Tang, Shijie and Chen, Haokun and Zhou, Shijie and Ma, Yunpu and Tresp, Volker},
  editor      = {Christodoulopoulos, Christos and Chakraborty, Tanmoy and Rose, Carolyn and Peng, Violet},
  booktitle   = {Proceedings of the 2025 Conference on Empirical Methods in Natural Language Processing},
  month       = nov,
  year        = {2025},
  address     = {Suzhou, China},
  publisher   = {Association for Computational Linguistics},
  url         = {https://aclanthology.org/2025.emnlp-main.93/},
  doi         = {10.18653/v1/2025.emnlp-main.93},
  pages       = {1778--1818},
  isbn        = {979-8-89176-332-6},
  abstract    = {The rapid progress of Large Language Models has advanced agentic systems in decision-making, coordination, and task execution. Yet, existing agentic system generation frameworks lack full autonomy, missing from-scratch agent generation, self-optimizing agent functionality, and collaboration, limiting adaptability and scalability. We propose SwarmAgentic, the first framework that fully automates agentic system generation, optimization, and collaboration, constructing agents from scratch and jointly refining functionality and coordination via language-driven exploration. To enable efficient search over system-level structures, SwarmAgentic maintains a population of candidate systems and evolves them via feedback-guided updates, drawing inspiration from Particle Swarm Optimization (PSO). We evaluate our method on six real-world, open-ended, and exploratory tasks involving high-level planning, system-level coordination, and creative reasoning. Given only a task description and an objective function, SwarmAgentic outperforms all baselines, achieving a +261.8% relative improvement over ADAS on the TravelPlanner benchmark, highlighting the effectiveness of full automation in structurally unconstrained tasks. This framework marks a significant step toward scalable and autonomous agentic system design, bridging swarm intelligence with fully automated system multi-agent generation.},
  pdf         = {https://aclanthology.org/2025.emnlp-main.93.pdf},
  arxiv       = {2506.15672},
  code        = {https://github.com/YaoZ720/SwarmAgenticCode},
  website     = {https://yaozhang.ai/swarmagentic/},
  venue       = {Conference on Empirical Methods in Natural Language Processing (EMNLP)},
  preview     = {swarmagentic.png},
  preview_full = {swarmagentic_full.png},
  role        = {Co-Author},
  tldr        = {SwarmAgentic builds agentic systems from scratch and evolves a population of them with a language-driven take on Particle Swarm Optimization, beating ADAS by 261.8% on TravelPlanner.},
  selected    = {true}
}
